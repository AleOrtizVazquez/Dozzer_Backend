<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!-- Identificador permanente del bien para su etiqueta QR.
         Se genera una sola vez y no cambia aunque se edite la clave u otros datos. -->
    <changeSet id="0019-bienes-codigo-qr" author="dozzer">
        <addColumn tableName="bienes">
            <column name="codigo_qr" type="VARCHAR(36)"/>
        </addColumn>
        <sql>UPDATE bienes SET codigo_qr = gen_random_uuid()::text WHERE codigo_qr IS NULL;</sql>
        <addNotNullConstraint tableName="bienes" columnName="codigo_qr" columnDataType="VARCHAR(36)"/>
        <addUniqueConstraint tableName="bienes" columnNames="codigo_qr" constraintName="uk_bienes_codigo_qr"/>
    </changeSet>

</databaseChangeLog>
