<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-usuario-sedes" author="dozzer">

        <createTable tableName="usuario_sedes">
            <column name="id_usuario" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="id_sede" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="usuario_sedes"
                columnNames="id_usuario,id_sede"
                constraintName="pk_usuario_sedes"/>

        <addForeignKeyConstraint
                baseTableName="usuario_sedes"
                baseColumnNames="id_usuario"
                referencedTableName="usuarios"
                referencedColumnNames="id_usuario"
                constraintName="fk_usuario_sedes_usuario"/>

        <addForeignKeyConstraint
                baseTableName="usuario_sedes"
                baseColumnNames="id_sede"
                referencedTableName="cat_sedes"
                referencedColumnNames="id_sede"
                constraintName="fk_usuario_sedes_sede"/>

    </changeSet>
</databaseChangeLog>
