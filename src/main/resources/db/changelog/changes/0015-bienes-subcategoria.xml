<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="add-subcategoria-bienes" author="dozzer">

        <addColumn tableName="bienes" schemaName="public">
            <column name="id_subcategoria" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableSchemaName="public"
                baseTableName="bienes"
                baseColumnNames="id_subcategoria"
                constraintName="fk_bien_subcategoria"
                referencedTableSchemaName="public"
                referencedTableName="cat_subcategorias"
                referencedColumnNames="id_subcategoria"/>

    </changeSet>

</databaseChangeLog>