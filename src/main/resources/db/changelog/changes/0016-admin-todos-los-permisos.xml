<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!-- El rol ADMIN recibe todos los permisos existentes, para que el login
         devuelva la lista completa y el frontend muestre todas las opciones. -->
    <changeSet id="0016-admin-todos-los-permisos" author="dozzer">
        <sql>
            INSERT INTO rol_permisos (id_rol, id_permiso)
            SELECT r.id, p.id_permiso
            FROM roles r
            CROSS JOIN permisos p
            WHERE r.nombre = 'ADMIN'
              AND NOT EXISTS (
                  SELECT 1 FROM rol_permisos rp
                  WHERE rp.id_rol = r.id AND rp.id_permiso = p.id_permiso
              );
        </sql>
    </changeSet>

</databaseChangeLog>
