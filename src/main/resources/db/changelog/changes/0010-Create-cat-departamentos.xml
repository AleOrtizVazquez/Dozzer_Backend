<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0010-Create-cat-departamentos" author="dozzer">

        <createTable tableName="cat_departamentos">

            <column name="id_departamento" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             nullable="false"/>
            </column>

            <column name="nombre_departamento" type="VARCHAR(180)">
                <constraints nullable="false"/>
            </column>

            <column name="estatus" type="BOOLEAN" defaultValueBoolean="true"/>

        </createTable>

    </changeSet>

</databaseChangeLog>
