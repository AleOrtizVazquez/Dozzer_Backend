<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!-- Firma guardada de cada usuario (PNG en base64, ~10-60 KB): se usa en cualquier celular o computadora -->
    <changeSet id="0032-usuario-firma" author="dozzer">
        <addColumn tableName="usuarios">
            <column name="firma" type="TEXT"/>
            <column name="firma_actualizada" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
