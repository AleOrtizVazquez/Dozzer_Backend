<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="create-cat-entidades" author="dozzer">

        <createTable tableName="cat_entidades" schemaName="public">

            <column name="id_entidad" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_cat_entidades"
                             nullable="false"/>
            </column>

            <column name="nombre_entidad" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="abreviatura" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="estatus" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

        </createTable>

    </changeSet>

</databaseChangeLog>