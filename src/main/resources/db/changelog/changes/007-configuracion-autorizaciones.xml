<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="007-configuracion-autorizaciones" author="dozzer">
        <createTable tableName="configuracion_autorizaciones">
            <column name="id_configuracion" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tipo_operacion" type="VARCHAR(30)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="requiere_autorizacion" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="configuracion_autorizaciones">
            <column name="tipo_operacion" value="ALTA"/>
            <column name="requiere_autorizacion" valueBoolean="true"/>
        </insert>

        <insert tableName="configuracion_autorizaciones">
            <column name="tipo_operacion" value="MODIFICACION"/>
            <column name="requiere_autorizacion" valueBoolean="true"/>
        </insert>

        <insert tableName="configuracion_autorizaciones">
            <column name="tipo_operacion" value="BAJA"/>
            <column name="requiere_autorizacion" valueBoolean="true"/>
        </insert>
    </changeSet>

</databaseChangeLog>
