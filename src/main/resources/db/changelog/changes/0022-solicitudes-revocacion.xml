<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!-- Revocación de autorizaciones:
         datos_anteriores = copia del bien antes de aplicar una modificación aprobada (para poder deshacerla).
         motivo/fecha/usuario de la última revocación, como registro de auditoría. -->
    <changeSet id="0022-solicitudes-revocacion" author="dozzer">
        <addColumn tableName="solicitudes_bienes">
            <column name="datos_anteriores" type="JSONB"/>
            <column name="motivo_revocacion" type="VARCHAR(500)"/>
            <column name="fecha_revocacion" type="TIMESTAMP"/>
            <column name="id_usuario_revoco" type="BIGINT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
