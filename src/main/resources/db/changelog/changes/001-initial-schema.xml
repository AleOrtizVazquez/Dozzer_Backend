<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
 <changeSet id="001-security-and-catalogs" author="dozzer">
  <createTable tableName="roles">
   <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
   <column name="nombre" type="VARCHAR(40)"><constraints nullable="false" unique="true"/></column>
  </createTable>
  <createTable tableName="cat_sedes">
   <column name="id_sede" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
   <column name="entidad" type="VARCHAR(120)"/><column name="nombre_sede" type="VARCHAR(150)"><constraints nullable="false"/></column>
   <column name="prefijo_clave" type="VARCHAR(20)"/><column name="estatus" type="BOOLEAN" defaultValueBoolean="true"/>
  </createTable>
  <createTable tableName="cat_puestos_deptos">
   <column name="id_puesto" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
   <column name="nombre_departamento" type="VARCHAR(150)"/><column name="nombre_puesto" type="VARCHAR(150)"><constraints nullable="false"/></column>
  </createTable>
  <createTable tableName="cat_personas">
   <column name="id_persona" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
   <column name="nombre_completo" type="VARCHAR(180)"><constraints nullable="false"/></column>
   <column name="correo" type="VARCHAR(180)"/><column name="id_puesto" type="BIGINT"/><column name="id_sede" type="BIGINT"/>
   <column name="estatus" type="BOOLEAN" defaultValueBoolean="true"/>
  </createTable>
  <addForeignKeyConstraint baseTableName="cat_personas" baseColumnNames="id_puesto" referencedTableName="cat_puestos_deptos" referencedColumnNames="id_puesto" constraintName="fk_persona_puesto"/>
  <addForeignKeyConstraint baseTableName="cat_personas" baseColumnNames="id_sede" referencedTableName="cat_sedes" referencedColumnNames="id_sede" constraintName="fk_persona_sede"/>
  <createTable tableName="cat_ubicaciones">
   <column name="id_ubicacion" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
   <column name="id_sede" type="BIGINT"><constraints nullable="false"/></column>
   <column name="tipo_ubicacion" type="VARCHAR(80)"/><column name="nombre_area" type="VARCHAR(150)"><constraints nullable="false"/></column>
   <column name="estatus" type="BOOLEAN" defaultValueBoolean="true"/>
  </createTable>
  <addForeignKeyConstraint baseTableName="cat_ubicaciones" baseColumnNames="id_sede" referencedTableName="cat_sedes" referencedColumnNames="id_sede" constraintName="fk_ubicacion_sede"/>
  <createTable tableName="cat_clasificaciones">
   <column name="id_clasificacion" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
   <column name="codigo" type="VARCHAR(40)"/><column name="nombre" type="VARCHAR(150)"><constraints nullable="false" unique="true"/></column>
  </createTable>
  <createTable tableName="cat_marcas">
   <column name="id_marca" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
   <column name="nombre_marca" type="VARCHAR(120)"><constraints nullable="false" unique="true"/></column>
  </createTable>
  <createTable tableName="cat_colores">
   <column name="id_color" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
   <column name="nombre_color" type="VARCHAR(80)"><constraints nullable="false" unique="true"/></column>
  </createTable>
  <createTable tableName="usuarios">
   <column name="id_usuario" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
   <column name="correo" type="VARCHAR(180)"><constraints nullable="false" unique="true"/></column>
   <column name="password" type="VARCHAR(255)"><constraints nullable="false"/></column>
   <column name="id_persona" type="BIGINT"/><column name="activo" type="BOOLEAN" defaultValueBoolean="true"/>
   <column name="fecha_creacion" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
  </createTable>
  <addForeignKeyConstraint baseTableName="usuarios" baseColumnNames="id_persona" referencedTableName="cat_personas" referencedColumnNames="id_persona" constraintName="fk_usuario_persona"/>
  <createTable tableName="usuario_roles">
   <column name="id_usuario" type="BIGINT"><constraints nullable="false"/></column><column name="id_rol" type="BIGINT"><constraints nullable="false"/></column>
  </createTable>
  <addPrimaryKey tableName="usuario_roles" columnNames="id_usuario,id_rol" constraintName="pk_usuario_roles"/>
  <addForeignKeyConstraint baseTableName="usuario_roles" baseColumnNames="id_usuario" referencedTableName="usuarios" referencedColumnNames="id_usuario" constraintName="fk_ur_usuario"/>
  <addForeignKeyConstraint baseTableName="usuario_roles" baseColumnNames="id_rol" referencedTableName="roles" referencedColumnNames="id" constraintName="fk_ur_rol"/>
  <insert tableName="roles"><column name="nombre" value="ADMIN"/></insert>
  <insert tableName="roles"><column name="nombre" value="CAPTURISTA"/></insert>
 </changeSet>
 <changeSet id="002-goods-and-operations" author="dozzer">
  <createTable tableName="bienes">
   <column name="id_bien" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
   <column name="clave" type="VARCHAR(80)"><constraints nullable="false" unique="true"/></column>
   <column name="id_bien_padre" type="BIGINT"/><column name="id_clasificacion" type="BIGINT"/>
   <column name="articulo" type="VARCHAR(180)"><constraints nullable="false"/></column>
   <column name="caracteristicas" type="TEXT"/><column name="id_marca" type="BIGINT"/>
   <column name="modelo" type="VARCHAR(120)"/><column name="numero_serie" type="VARCHAR(150)"/>
   <column name="id_color" type="BIGINT"/><column name="unidad_medida" type="VARCHAR(40)"/>
   <column name="cantidad_piezas" type="INTEGER" defaultValueNumeric="1"/>
   <column name="id_responsable_area" type="BIGINT"/><column name="id_usuario_directo" type="BIGINT"/>
   <column name="id_ubicacion" type="BIGINT"/><column name="estatus_inventario" type="VARCHAR(40)" defaultValue="ACTIVO"/>
   <column name="estatus_asignacion" type="VARCHAR(40)" defaultValue="SIN_ASIGNAR"/>
   <column name="estado_fisico" type="VARCHAR(40)"/><column name="fecha_alta" type="DATE" defaultValueComputed="CURRENT_DATE"/>
   <column name="activo" type="BOOLEAN" defaultValueBoolean="true"/>
  </createTable>
  <addForeignKeyConstraint baseTableName="bienes" baseColumnNames="id_bien_padre" referencedTableName="bienes" referencedColumnNames="id_bien" constraintName="fk_bien_padre"/>
  <addForeignKeyConstraint baseTableName="bienes" baseColumnNames="id_clasificacion" referencedTableName="cat_clasificaciones" referencedColumnNames="id_clasificacion" constraintName="fk_bien_clasificacion"/>
  <addForeignKeyConstraint baseTableName="bienes" baseColumnNames="id_marca" referencedTableName="cat_marcas" referencedColumnNames="id_marca" constraintName="fk_bien_marca"/>
  <addForeignKeyConstraint baseTableName="bienes" baseColumnNames="id_color" referencedTableName="cat_colores" referencedColumnNames="id_color" constraintName="fk_bien_color"/>
  <addForeignKeyConstraint baseTableName="bienes" baseColumnNames="id_responsable_area" referencedTableName="cat_personas" referencedColumnNames="id_persona" constraintName="fk_bien_responsable"/>
  <addForeignKeyConstraint baseTableName="bienes" baseColumnNames="id_usuario_directo" referencedTableName="cat_personas" referencedColumnNames="id_persona" constraintName="fk_bien_usuario_directo"/>
  <addForeignKeyConstraint baseTableName="bienes" baseColumnNames="id_ubicacion" referencedTableName="cat_ubicaciones" referencedColumnNames="id_ubicacion" constraintName="fk_bien_ubicacion"/>
  <createTable tableName="historial_movimientos">
   <column name="id_movimiento" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
   <column name="tipo_movimiento" type="VARCHAR(60)"><constraints nullable="false"/></column>
   <column name="fecha" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
   <column name="id_persona_origen" type="BIGINT"/><column name="id_persona_destino" type="BIGINT"/>
   <column name="id_ubicacion_origen" type="BIGINT"/><column name="id_ubicacion_destino" type="BIGINT"/>
   <column name="observaciones" type="TEXT"/>
  </createTable>
  <createTable tableName="historial_movimientos_detalle">
   <column name="id_detalle" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
   <column name="id_movimiento" type="BIGINT"><constraints nullable="false"/></column>
   <column name="id_bien" type="BIGINT"><constraints nullable="false"/></column>
   <column name="estado_fisico_momento" type="VARCHAR(60)"/>
  </createTable>
  <addForeignKeyConstraint baseTableName="historial_movimientos_detalle" baseColumnNames="id_movimiento" referencedTableName="historial_movimientos" referencedColumnNames="id_movimiento" constraintName="fk_detalle_movimiento"/>
  <addForeignKeyConstraint baseTableName="historial_movimientos_detalle" baseColumnNames="id_bien" referencedTableName="bienes" referencedColumnNames="id_bien" constraintName="fk_detalle_bien"/>
  <createTable tableName="documentos_archivos">
   <column name="id_documento" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
   <column name="id_bien" type="BIGINT"/><column name="id_movimiento" type="BIGINT"/>
   <column name="tipo_documento" type="VARCHAR(60)"/><column name="object_key" type="VARCHAR(500)"/>
   <column name="content_type" type="VARCHAR(150)"/><column name="tamano_bytes" type="BIGINT"/>
   <column name="fecha_subida" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
   <column name="id_usuario_carga" type="BIGINT"/>
  </createTable>
  <addForeignKeyConstraint baseTableName="documentos_archivos" baseColumnNames="id_bien" referencedTableName="bienes" referencedColumnNames="id_bien" constraintName="fk_documento_bien"/>
  <addForeignKeyConstraint baseTableName="documentos_archivos" baseColumnNames="id_movimiento" referencedTableName="historial_movimientos" referencedColumnNames="id_movimiento" constraintName="fk_documento_movimiento"/>
  <addForeignKeyConstraint baseTableName="documentos_archivos" baseColumnNames="id_usuario_carga" referencedTableName="usuarios" referencedColumnNames="id_usuario" constraintName="fk_documento_usuario"/>
  <createTable tableName="control_fisico">
   <column name="id_control" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
   <column name="id_bien" type="BIGINT"><constraints nullable="false"/></column><column name="fecha_revision" type="DATE"><constraints nullable="false"/></column>
   <column name="id_ubicacion_encontrada" type="BIGINT"/><column name="estado_fisico_encontrado" type="VARCHAR(60)"/>
   <column name="resultado" type="VARCHAR(60)"/>
  </createTable>
  <addForeignKeyConstraint baseTableName="control_fisico" baseColumnNames="id_bien" referencedTableName="bienes" referencedColumnNames="id_bien" constraintName="fk_control_bien"/>
  <addForeignKeyConstraint baseTableName="control_fisico" baseColumnNames="id_ubicacion_encontrada" referencedTableName="cat_ubicaciones" referencedColumnNames="id_ubicacion" constraintName="fk_control_ubicacion"/>
 </changeSet>
</databaseChangeLog>
