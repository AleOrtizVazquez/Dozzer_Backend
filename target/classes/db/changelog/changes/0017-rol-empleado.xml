<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!-- Renombra el rol CAPTURISTA a EMPLEADO (los usuarios que ya lo tengan lo conservan). -->
    <changeSet id="0017-renombrar-capturista-empleado" author="dozzer">
        <update tableName="roles">
            <column name="nombre" value="EMPLEADO"/>
            <where>nombre = 'CAPTURISTA'</where>
        </update>
    </changeSet>

    <!-- El EMPLEADO puede consultar y solicitar altas, modificaciones y bajas de bienes.
         Sus operaciones quedan PENDIENTES hasta que el ADMIN las autorice. -->
    <changeSet id="0017-permisos-empleado" author="dozzer">
        <sql>
            INSERT INTO rol_permisos (id_rol, id_permiso)
            SELECT r.id, p.id_permiso
            FROM roles r
            CROSS JOIN permisos p
            WHERE r.nombre = 'EMPLEADO'
              AND p.codigo IN ('BIENES_CONSULTAR', 'BIENES_CREAR', 'BIENES_MODIFICAR',
                               'BIENES_ELIMINAR', 'SOLICITUDES_CONSULTAR')
              AND NOT EXISTS (
                  SELECT 1 FROM rol_permisos rp
                  WHERE rp.id_rol = r.id AND rp.id_permiso = p.id_permiso
              );
        </sql>
    </changeSet>

</databaseChangeLog>
