<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-permissions" author="dozzer">

        <createTable tableName="permisos">
            <column name="id_permiso" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="codigo" type="VARCHAR(80)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="nombre" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="descripcion" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="rol_permisos">
            <column name="id_rol" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="id_permiso" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="rol_permisos"
                columnNames="id_rol,id_permiso"
                constraintName="pk_rol_permisos"/>

        <addForeignKeyConstraint
                baseTableName="rol_permisos"
                baseColumnNames="id_rol"
                referencedTableName="roles"
                referencedColumnNames="id"
                constraintName="fk_rol_permisos_rol"/>

        <addForeignKeyConstraint
                baseTableName="rol_permisos"
                baseColumnNames="id_permiso"
                referencedTableName="permisos"
                referencedColumnNames="id_permiso"
                constraintName="fk_rol_permisos_permiso"/>

    </changeSet>
</databaseChangeLog>
