<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!-- Fecha en que el usuario pidió restablecer su contraseña desde el login.
         Queda vacía cuando no hay solicitud pendiente. -->
    <changeSet id="0020-usuarios-recuperacion-password" author="dozzer">
        <addColumn tableName="usuarios">
            <column name="recuperacion_solicitada" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
