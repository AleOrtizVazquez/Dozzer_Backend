<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0011-modify-cat-puestos-deptos-001" author="dozzer">

        <dropColumn
                tableName="cat_puestos_deptos"
                columnName="nombre_departamento"/>

        <addColumn tableName="cat_puestos_deptos">
            <column name="id_departamento" type="BIGINT"/>
            <column name="estatus" type="BOOLEAN" defaultValueBoolean="true"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="cat_puestos_deptos"
                baseColumnNames="id_departamento"
                referencedTableName="cat_departamentos"
                referencedColumnNames="id_departamento"
                constraintName="fk_puesto_departamento"/>

    </changeSet>

</databaseChangeLog>
