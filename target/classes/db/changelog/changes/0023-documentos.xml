<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!-- Formatos de Alta/Baja. No se guarda el PDF: solo una copia congelada de sus datos (≈2 KB);
         el PDF se arma al momento de abrirlo y siempre sale idéntico. -->
    <changeSet id="0023-documentos" author="dozzer">
        <createTable tableName="documentos">
            <column name="id_documento" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tipo" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="folio" type="VARCHAR(30)"/>
            <column name="estado" type="VARCHAR(20)" defaultValue="VIGENTE"><constraints nullable="false"/></column>
            <column name="id_sede" type="BIGINT"/>
            <column name="id_bien" type="BIGINT"/>
            <column name="id_solicitud" type="BIGINT"/>
            <column name="id_usuario_solicitante" type="BIGINT"/>
            <column name="id_usuario_autorizo" type="BIGINT"/>
            <column name="datos" type="JSONB"><constraints nullable="false"/></column>
            <column name="fecha_creacion" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="documentos" columnNames="folio" constraintName="uk_documentos_folio"/>
        <createIndex tableName="documentos" indexName="ix_documentos_sede"><column name="id_sede"/></createIndex>
        <createIndex tableName="documentos" indexName="ix_documentos_solicitante"><column name="id_usuario_solicitante"/></createIndex>
        <createIndex tableName="documentos" indexName="ix_documentos_solicitud"><column name="id_solicitud"/></createIndex>
        <createIndex tableName="documentos" indexName="ix_documentos_bien"><column name="id_bien"/></createIndex>
    </changeSet>

</databaseChangeLog>
