<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008-fk-solicitudes-sede" author="dozzer">

        <!-- Agregar columna de sede -->
        <addColumn tableName="solicitudes_bienes">
            <column name="id_sede" type="BIGINT"/>
        </addColumn>

        <!-- Crear llave foránea -->
        <addForeignKeyConstraint
                baseTableName="solicitudes_bienes"
                baseColumnNames="id_sede"
                referencedTableName="cat_sedes"
                referencedColumnNames="id_sede"
                constraintName="fk_solicitudes_bienes_sede"/>

    </changeSet>

</databaseChangeLog>
